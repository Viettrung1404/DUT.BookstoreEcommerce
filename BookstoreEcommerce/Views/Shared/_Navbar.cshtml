<!-- Navbar start -->
<div class="container-fluid fixed-top">
    <div class="container px-0">
        <nav class="navbar navbar-light bg-white navbar-expand-xl">
            <a asp-action="Index" asp-controller="Home" class="navbar-brand"><h1 class="text-primary display-6">BookBridge</h1></a>
            <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars text-primary"></span>
            </button>
            <div class="collapse navbar-collapse bg-white" id="navbarCollapse">
                <div class="navbar-nav mx-auto">
                    <a asp-action="Index" asp-controller="Home" class="nav-item nav-link active">Trang chủ</a>
                    <a asp-action="Index" asp-controller="Sach" class="nav-item nav-link">Sách</a>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <!-- Hiển thị khi đã đăng nhập -->
                        <a asp-action="LichSu" asp-controller="Cart" class="nav-item nav-link">Lịch sử mua hàng</a>
                        <li class="nav-item">
                            <form asp-controller="KhachHang" asp-action="DangXuat" method="post">
                                <button type="submit" class="nav-link btn btn-link">Đăng xuất</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <!-- Hiển thị khi chưa đăng nhập -->
                        <a asp-action="DangKy" asp-controller="KhachHang" class="nav-item nav-link">Đăng ký</a>
                        <a asp-action="DangNhap" asp-controller="KhachHang" class="nav-item nav-link">Đăng nhập</a>
                    }
                </div>
                <div class="d-flex m-3 me-0">
                    <button class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fas fa-search text-primary"></i></button>
                    @await Component.InvokeAsync("Cart")
                    <a asp-action="ThongTin" asp-controller="KhachHang" class="my-auto">
                        <i class="fas fa-user fa-2x"></i>
                    </a>
                </div>
            </div>
        </nav>
    </div>
</div>
<!-- Navbar End -->

<!-- Modal Search Start -->
<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content rounded-0">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Tìm kiếm theo từ khóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center">
                <div class="input-group w-75 mx-auto d-flex">
                    <input id="searchBoxNav" type="search" class="form-control p-3" placeholder="keywords" aria-describedby="search-icon-1">
                    <span id="searchBtnNav" class="input-group-text p-3"><i class="fa fa-search"></i></span>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Search End -->
