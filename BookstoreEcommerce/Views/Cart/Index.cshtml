@using System.Globalization
@model IEnumerable<BookstoreEcommerce.ViewModels.CartViewModel>

@{
    ViewData["Title"] = "Cart";
    var tongTienSach = Model.Sum(p => p.TongTien);
    var freeShipping = tongTienSach >= 300000;
    var shippingFee = freeShipping ? 0 : 30000;
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Giỏ hàng</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white">Giỏ hàng</li>
    </ol>
</div>
<!-- Single Page Header End -->


<!-- Cart Page Start -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Sách</th>
                        <th scope="col">Tên sách</th>
                        <th scope="col">Đơn giá</th>
                        <th scope="col">Số lượng</th>
                        <th scope="col">Tổng tiền</th>
                        <th scope="col">Xóa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <th scope="row">
                                <a asp-action="Details" asp-controller="Sach" asp-route-id="@item.MaSach">
                                    <div class="d-flex align-items-center">
                                        <img src="~/img/Sach/@item.Hinh" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px;" alt="@item.TenSach">
                                    </div>
                                </a>
                            </th>
                            <td>
                                <a asp-action="Details" asp-controller="Sach" asp-route-id="@item.MaSach"><p class="mb-0 mt-4">@item.TenSach</p></a>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@item.DonGia.ToString("C", new CultureInfo("vi-VN"))</p>
                            </td>
                            <td>
                                <div class="input-group quantity mt-4" style="width: 100px;">
                                    
                                    <input type="text" class="form-control form-control-sm text-center border-0" value="@item.SoLuong">
                                    
                                </div>
                            </td>
                            <td>
                                <p class="mb-0 mt-4">@item.TongTien.ToString("C", new CultureInfo("vi-VN"))</p>
                            </td>
                            <td>
                                <a asp-action="RemoveCart" asp-controller="Cart" asp-route-id="@item.MaSach" class="btn btn-md rounded-circle bg-light border mt-4">
                                    <i class="fa fa-times text-danger"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-5">
            <input type="text" class="border-0 border-bottom rounded me-5 py-3 mb-4" placeholder="Coupon Code">
            <button class="btn border-secondary rounded-pill px-4 py-3 text-primary" type="button">Áp mã giảm giá</button>
        </div>
        <div class="row g-4 justify-content-end">
            <div class="col-8"></div>
            <div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
                <div class="bg-light rounded">
                    <div class="p-4">
                        <h1 class="display-6 mb-4">Giỏ hàng <span class="fw-normal">Thành tiền</span></h1>
                        <div class="d-flex justify-content-between mb-4">
                            <h5 class="mb-0 me-4">Tiền sách:</h5>
                            <p class="mb-0">@Model.Sum(p => p.TongTien).ToString("C", new CultureInfo("vi-VN"))</p>
                        </div>
                        <div class="d-flex justify-content-between">
                            <h5 class="mb-0 me-4">Tiền vận chuyển</h5>
                            <div class="">
                                <p class="mb-0">@(freeShipping ? "Miễn phí" : shippingFee.ToString("C", new CultureInfo("vi-VN")))</p>
                            </div>
                        </div>
                    </div>
                    <div class="py-4 mb-4 border-top border-bottom d-flex justify-content-between">
                        <h5 class="mb-0 ps-4 me-4">Tổng</h5>
                        <p class="mb-0 pe-4">@((tongTienSach + shippingFee).ToString("C", new CultureInfo("vi-VN")))</p>
                    </div>
                    <a class="btn border-secondary rounded-pill px-4 py-3 text-primary text-uppercase mb-4 ms-4" type="button" asp-action="Checkout" asp-controller="Cart">Thanh toán</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Cart Page End -->

