@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-12 col-lg-7">
                <h4 class="mb-3 text-secondary">Sách chính hãng 100%</h4>
                <h1 class="mb-5 display-3 text-third">Đa dạng thể loại sách</h1>
            </div>
            <div class="col-md-12 col-lg-5">
                <div id="carouselId" class="carousel slide position-relative" data-bs-ride="carousel">
                    <div class="carousel-inner" role="listbox" style="max-height: 60vh">
                        <div class="carousel-item active rounded">
                            <img src="~/img/Sach/dracula.jpg" class="img-fluid w-80 h-80 bg-secondary rounded" alt="First slide">
                            <a asp-action="Index" asp-controller="Sach" asp-route-loai="1005" class="btn px-4 py-2 text-white rounded">Kinh dị</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/img/Sach/naruto.jpg" class="img-fluid w-100 h-100 rounded" alt="Second slide">
                            <a asp-action="Index" asp-controller="Sach" asp-route-loai="1004" class="btn px-4 py-2 text-white rounded">Truyện tranh</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/img/Sach/night.jpg" class="img-fluid w-100 h-100 rounded" alt="Second slide">
                            <a asp-action="Index" asp-controller="Sach" asp-route-loai="1007" class="btn px-4 py-2 text-white rounded">Tự truyện</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/img/Sach/rich_dad_poor_dad.jpg" class="img-fluid w-100 h-100 rounded" alt="Second slide">
                            <a asp-action="Index" asp-controller="Sach" asp-route-loai="1008" class="btn px-4 py-2 text-white rounded">Giáo dục</a>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->

<!-- Featurs Section Start -->
<div class="container-fluid featurs py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-car-side fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Miễn phí vận chuyển</h5>
                        <p class="mb-0">Miễn phí cho đơn hàng trên 300k</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-user-shield fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Bảo mật thanh toán</h5>
                        <p class="mb-0">Thanh toán an toàn 100%</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fa fa-phone-alt fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>24/7 Hỗ trợ</h5>
                        <p class="mb-0">Hỗ trợ qua Zalo 08687xxxxx</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Featurs Section End -->
