@{
    var Hinh = User.Claims.FirstOrDefault(c => c.Type == "Hinh")?.Value;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlightBookingWeb</title>
    @* <link rel="stylesheet" href="~/css/site.css" /> *@
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" /> *@
    <!-- Favicon -->
    <link href="~/img/book.png" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/admin/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/admin/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/admin/css/style.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="container-fluid position-relative bg-white d-flex p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
        <!-- Sidebar Start -->
        <div class="sidebar pe-4 pb-3">
            <nav class="navbar bg-light navbar-light">
                <a asp-area="Admin" asp-action="Index" asp-controller="Home" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-primary"><i class="fa fa-hashtag me-2"></i>BookBridge</h3>
                </a>
                <div class="d-flex align-items-center ms-4 mb-4">
                    <div class="position-relative">
                        <img class="rounded-circle" src="~/img/KhachHang/@Hinh" alt="" style="width: 40px; height: 40px;">
                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">@User.Identity.Name</h6>
                        <span>Admin</span>
                    </div>
                </div>
                <div class="navbar-nav w-100">
                    @* <a asp-area="Admin" asp-action="Index" asp-controller="Home" class="nav-item nav-link active"><i class="fa fa-chart-bar me-2"></i>Thống kê</a> *@
                    <a asp-area="Admin" asp-action="Index" asp-controller="KhachHang" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "KhachHang" ? "active" : "")"><i class="fa fa-tachometer-alt me-2"></i>Tài khoản</a>
                    <a asp-area="Admin" asp-action="Index" asp-controller="Sach" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Sach" ? "active" : "")"><i class="fa fa-th me-2"></i>Sách</a>
                    <a asp-area="Admin" asp-action="Index" asp-controller="Loai" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Loai" ? "active" : "")"><i class="fa fa-keyboard me-2"></i>Thể loại</a>
                </div>
            </nav>
        </div>
        <!-- Sidebar End -->
        <!-- Content Start -->
        <div class="content">
            <!-- Navbar Start -->
            <nav class="navbar navbar-expand bg-light navbar-light sticky-top px-4 py-0">
                <a asp-action="Index" asp-controller="Home" class="navbar-brand d-flex d-lg-none me-4">
                    <h2 class="text-primary mb-0"><i class="fa fa-hashtag"></i></h2>
                </a>
                <a href="#" class="sidebar-toggler flex-shrink-0">
                    <i class="fa fa-bars"></i>
                </a>
                <div class="navbar-nav align-items-center ms-auto">
                    <div class="nav-item">
                        <a asp-area="" asp-action="Index" asp-controller="Home" class="nav-link">
                            Chuyển về giao diện người dùng
                        </a>
                    </div>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img class="rounded-circle me-lg-2" src="~/img/KhachHang/@Hinh" alt="" style="width: 40px; height: 40px;">
                            <span class="d-none d-lg-inline-flex">@User.Identity.Name</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end bg-light border-0 rounded-0 rounded-bottom m-0">
                            @* <a asp-area="" asp-action="Profile" asp-controller="Account" class="dropdown-item">Thông tin của bạn</a> *@
                            <a asp-area="" asp-action="Logout" asp-controller="Account" class="dropdown-item">Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </nav>
            <!-- Navbar End -->
            <!-- Render Body Start -->
            <div class="p-3" style="min-height: 100vh">
                @RenderBody()
            </div>
            <!-- Render Body End -->
            <!-- Back to Top -->
            <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
        </div>
        <!-- Content End -->
        <!-- JavaScript Libraries -->
        <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/admin/lib/chart/chart.min.js"></script>
        <script src="~/admin/lib/easing/easing.min.js"></script>
        <script src="~/admin/lib/waypoints/waypoints.min.js"></script>
        <script src="~/admin/lib/owlcarousel/owl.carousel.min.js"></script>
        <script src="~/admin/lib/tempusdominus/js/moment.min.js"></script>
        <script src="~/admin/lib/tempusdominus/js/moment-timezone.min.js"></script>
        <script src="~/admin/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>

        <!-- Template Javascript -->
        <script src="~/admin/js/main.js"></script>

        <!-- Custom Scripts -->
        @RenderSection("Scripts", required: false)
    </div>
</body>
</html>
