@model IEnumerable<BookstoreEcommerce.Areas.Admin.ViewModels.KhachHangViewModel>

    <div class="container-fluid">
        <h2 class="mt-4 mb-4">Quản lý khách hàng</h2>

        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Danh sách khách hàng</h6>
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Thêm mới
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Mã KH</th>
                                <th>Họ tên</th>
                                <th>Giới tính</th>
                                <th>Email</th>
                                <th>Điện thoại</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th style="width: 150px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MaKh</td>
                                    <td>@item.HoTen</td>
                                    <td>@(item.GioiTinh ? "Nam" : "Nữ")</td>
                                    <td>@item.Email</td>
                                    <td>@item.DienThoai</td>
                                    <td>@(item.VaiTro == 1 ? "Admin" : "Khách hàng")</td>
                                    <td>
                                        <span class="badge @(item.HieuLuc ? "badge-success" : "badge-danger")">
                                            @(item.HieuLuc ? "Hoạt động" : "Khóa")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="@Url.Action("Details", new { id = item.MaKh })" class="btn btn-info btn-sm">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = item.MaKh })" class="btn btn-warning btn-sm mx-1">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = item.MaKh })" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#dataTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json"
                    }
                });
            });
        </script>
    }
