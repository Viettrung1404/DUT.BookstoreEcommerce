@model BookstoreEcommerce.Areas.Admin.ViewModels.KhachHangViewModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid">
    <h2 class="mt-4 mb-4 text-danger">Xác nhận xóa khách hàng</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-danger">
            <h6 class="m-0 font-weight-bold text-white">
                <i class="fas fa-exclamation-triangle mr-2"></i>Bạn chắc chắn muốn xóa khách hàng này?
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-4">
                    <div class="profile-image-container">
                        @if (!string.IsNullOrEmpty(Model.Hinh))
                        {
                            <img src="@Url.Content("~/Content/Images/KhachHang/" + Model.Hinh)" alt="@Model.HoTen" class="img-profile rounded-circle img-fluid border p-1" style="width: 200px; height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <img src="@Url.Content("~/Content/Images/no-avatar.png")" alt="No Image" class="img-profile rounded-circle img-fluid border p-1" style="width: 200px; height: 200px; object-fit: cover;">
                        }
                    </div>
                    <div class="mt-3">
                        <h5 class="font-weight-bold">@Model.HoTen</h5>
                        <p class="text-muted">@Model.Email</p>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="alert alert-warning">
                        <p><strong>Lưu ý:</strong> Hành động này không thể hoàn tác. Tất cả dữ liệu liên quan đến khách hàng này sẽ bị xóa!</p>
                    </div>
                    <table class="table table-hover">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">Mã khách hàng</th>
                                <td>@Model.MaKh</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <th>Điện thoại</th>
                                <td>@(string.IsNullOrEmpty(Model.DienThoai) ? "Chưa cập nhật" : Model.DienThoai)</td>
                            </tr>
                            <tr>
                                <th>Vai trò</th>
                                <td>
                                    @if (Model.VaiTro == 1)
                                    {
                                        <span class="text-danger font-weight-bold">Quản trị viên</span>
                                    }
                                    else
                                    {
                                        <span>Khách hàng</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.MaKh)

                        <div class="form-actions mt-4">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt"></i> Xác nhận xóa
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">
                                <i class="fas fa-times"></i> Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>