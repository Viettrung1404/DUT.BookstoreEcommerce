@model BookstoreEcommerce.Areas.Admin.ViewModels.KhachHangViewModel

@{
    ViewData["Title"] = "Edit";
}


<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Cập nhật thông tin khách hàng</h1>
        <div>
            <a href="@Url.Action("Details", new { id = Model.MaKh })" class="btn btn-info btn-sm">
                <i class="fas fa-info-circle"></i> Xem chi tiết
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm ml-2">
                <i class="fas fa-list"></i> Danh sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-gradient-primary">
            <h6 class="m-0 font-weight-bold text-white">
                <i class="fas fa-user-edit mr-2"></i>Cập nhật thông tin khách hàng: @Model.HoTen
            </h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "KhachHang", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.MaKh)
                @Html.HiddenFor(model => model.RandomKey)
                @Html.HiddenFor(model => model.Hinh)

                <div class="row">
                    <div class="col-lg-4">
                        <div class="card border-left-warning shadow h-100 py-2 mb-4">
                            <div class="card-body">
                                <div class="text-center">
                                    <div class="position-relative mb-4">
                                        @if (!string.IsNullOrEmpty(Model.Hinh))
                                        {
                                            <img id="preview" src="@Url.Content("~/img/KhachHang/" + Model.Hinh)" alt="@Model.HoTen" class="img-profile rounded-circle border shadow" style="width: 200px; height: 200px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <img id="preview" src="@Url.Content("~/img/KhachHang/no-avatar.png")" alt="No Image" class="img-profile rounded-circle border shadow" style="width: 200px; height: 200px; object-fit: cover;">
                                        }
                                        @* <div class="position-absolute" style="bottom: 0; right: 0;"> *@
                                        @*     <label for="Hinh" class="btn btn-sm btn-circle btn-primary" style="width: 35px; height: 35px;"> *@
                                        @*         <i class="fas fa-camera"></i> *@
                                        @*     </label> *@
                                        @*     <input type="file" id="Hinh" name="HinhUpload" style="display: none;" onchange="previewImage(event)"> *@
                                        @* </div> *@
                                    </div>
                                    <h5 class="mb-1 font-weight-bold">@Model.HoTen</h5>
                                    <p class="text-muted">@Model.Email</p>
                                </div>

                                <hr>
                                
                                <div class="form-group">
                                    <label for="MaKh" class="font-weight-bold text-primary">
                                        <i class="fas fa-id-card mr-1"></i> Mã khách hàng
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-key"></i></span>
                                        </div>
                                        <input type="text" class="form-control bg-light" value="@Model.MaKh" disabled>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="MatKhau" class="font-weight-bold text-primary">
                                        <i class="fas fa-lock mr-1"></i> Mật khẩu mới
                                    </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-key"></i></span>
                                        </div>
                                        @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Để trống nếu không thay đổi" })
                                    </div>
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle"></i> Để trống nếu không muốn thay đổi mật khẩu
                                    </small>
                                </div>

                                <div class="form-group mb-4">
                                    <label class="font-weight-bold text-primary d-block mb-2">
                                        <i class="fas fa-user-shield mr-1"></i> Quyền và trạng thái
                                    </label>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="card border-left-primary shadow py-1">
                                                <div class="card-body p-2">
                                                    <label for="VaiTro" class="small mb-1">Vai trò</label>
                                                    <select class="form-control form-control-sm" id="VaiTro" name="VaiTro">
                                                        <option value="0" class="@(Model.VaiTro == 0 ? "selected" : "")">Khách hàng</option>
                                                        <option value="1" class="@(Model.VaiTro == 1 ? "selected" : "")">Quản trị viên</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card border-left-info shadow py-1">
                                                <div class="card-body p-2">
                                                    <label class="small mb-1">Trạng thái</label>
                                                    <div class="custom-control custom-switch">
                                                        @Html.CheckBoxFor(m => m.HieuLuc, new { @class = "custom-control-input", id = "HieuLuc" })
                                                        <label class="custom-control-label" for="HieuLuc">
                                                            <span id="statusText" class="@(Model.HieuLuc ? "text-success" : "text-danger")">
                                                                @(Model.HieuLuc ? "Đang hoạt động" : "Đã khóa")
                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        <div class="card border-left-success shadow h-100 py-2">
                            <div class="card-body">
                                <h6 class="font-weight-bold text-success mb-4">
                                    <i class="fas fa-user-edit mr-1"></i> Thông tin cá nhân
                                </h6>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="HoTen" class="font-weight-bold">
                                                Họ và tên <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                                </div>
                                                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nhập họ và tên" })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="Email" class="font-weight-bold">
                                                Email <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                                </div>
                                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Nhập email", type = "email" })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="DienThoai" class="font-weight-bold">Điện thoại</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                                </div>
                                                @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.DienThoai, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="NgaySinh" class="font-weight-bold">
                                                Ngày sinh <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                                </div>
                                                @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="font-weight-bold d-block">
                                        Giới tính <span class="text-danger">*</span>
                                    </label>
                                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                                        <label class="btn btn-outline-primary @(Model.GioiTinh ? "active" : "")">
                                            @Html.RadioButtonFor(m => m.GioiTinh, true, new { id = "gioiTinhNam", @checked = Model.GioiTinh })
                                            <i class="fas fa-mars mr-1"></i> Nam
                                        </label>
                                        <label class="btn btn-outline-primary @(Model.GioiTinh ? "" : "active")">
                                            @Html.RadioButtonFor(m => m.GioiTinh, false, new { id = "gioiTinhNu", @checked = !Model.GioiTinh })
                                            <i class="fas fa-venus mr-1"></i> Nữ
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="DiaChi" class="font-weight-bold">Địa chỉ</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                        </div>
                                        @Html.TextAreaFor(m => m.DiaChi, new { @class = "form-control", rows = "3", placeholder = "Nhập địa chỉ" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger small" })
                                </div>

                                <div class="form-group mb-0 mt-4">
                                    <button type="submit" class="btn btn-primary btn-block">
                                        <i class="fas fa-save mr-1"></i> Cập nhật thông tin
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function() {
                var output = document.getElementById('preview');
                output.src = reader.result;
            }
            reader.readAsDataURL(event.target.files[0]);
        }

        $(document).ready(function () {
            // Cập nhật trạng thái text khi thay đổi switch
            $('#HieuLuc').change(function() {
                if($(this).is(':checked')) {
                    $('#statusText').text('Đang hoạt động');
                    $('#statusText').removeClass('text-danger').addClass('text-success');
                } else {
                    $('#statusText').text('Đã khóa');
                    $('#statusText').removeClass('text-success').addClass('text-danger');
                }
            });

            // Validate form khi submit
            $('.needs-validation').submit(function(event) {
                if (this.checkValidity() === false) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
        });
    </script>
}
